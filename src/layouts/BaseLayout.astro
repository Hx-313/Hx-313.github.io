---
import '../styles/global.css';
import '../styles/mascots.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascots from '../components/Mascots.jsx';

const {
  title = 'Hire a Flutter App & SaaS Developer | Hafiz Ali Abdullah',
  description = 'Custom cross-platform Flutter apps and full SaaS platforms for founders in the US & UK. 5+ apps shipped, a nationwide ordering SaaS delivered. Book a free strategy call.',
  path = '/',
  ogImage = '/og-image.svg',
  jsonld = null,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://YOURDOMAIN.com';
const canonical = `${site}${path}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#060913" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}${ogImage}`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Site-wide structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person', '@id': `${site}/#person`, name: 'Hafiz Ali Abdullah',
        jobTitle: 'Flutter App & SaaS Developer', url: `${site}/`,
        sameAs: ['https://github.com/Hx-313', 'https://www.linkedin.com/in/hafiz-ali-abdullah-660429207'],
        knowsAbout: ['Flutter', 'Dart', 'iOS', 'Android', 'SaaS', 'Point of Sale', 'MVP Development'],
      },
      {
        '@type': 'ProfessionalService', '@id': `${site}/#service`,
        name: 'Hafiz Ali Abdullah — App & SaaS Development', url: `${site}/`,
        image: `${site}${ogImage}`, priceRange: '$$',
        founder: { '@id': `${site}/#person` },
        areaServed: [{ '@type': 'Country', name: 'United States' }, { '@type': 'Country', name: 'United Kingdom' }],
        serviceType: ['Mobile App Development', 'Cross-Platform App Development', 'SaaS Development', 'MVP Development'],
      },
    ],
  })} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <div class="glow-orbs"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div></div>
  <div class="particles"></div>

  <Header />
  <Mascots client:load />

  <main>
    <slot />
  </main>

  <Footer />

  <script>
    // Scroll-reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Animated counters
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = parseFloat(el.dataset.count || '0');
        const suffix = el.dataset.suffix || '';
        let n = 0; const step = target / 40;
        const tick = () => { n += step; if (n >= target) { el.textContent = target + suffix; } else { el.textContent = Math.floor(n) + suffix; requestAnimationFrame(tick); } };
        tick(); cio.unobserve(el);
      });
    }, { threshold: 0.5 });
    counters.forEach((el) => cio.observe(el));
  </script>
</body>
</html>
