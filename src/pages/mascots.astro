---
import BaseLayout from '../layouts/BaseLayout.astro';
import AeroMascot from '../components/mascots/AeroMascot.jsx';
import DashMascot from '../components/mascots/DashMascot.jsx';
---

<BaseLayout
  title="HX313 System Mascots · Aero & Dash"
  description="Meet the system crew: Aero (AI Assistant) and Dash (System Drone) by HX313 Product Engineer."
  path="/mascots"
>
  <div class="mascot-page-container" style="max-width: 1280px; margin: 0 auto; padding: 4rem 1.5rem;">
    <div style="border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 2rem; margin-bottom: 3rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="font-family: var(--font-mono, monospace); font-size: 0.8rem; color: #00FF66; letter-spacing: 2px; text-transform: uppercase;">HX313 · PRODUCT ENGINEER</div>
        <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 800; color: #fff; margin-top: 0.4rem;">Meet the <span style="color: #00FF66; text-shadow: 0 0 20px rgba(0,255,102,0.4);">Crew.</span></h1>
      </div>
      <div style="font-family: var(--font-mono, monospace); font-size: 0.75rem; color: #94a3b8; letter-spacing: 1.5px;">
        THINK • BUILD • DEPLOY
      </div>
    </div>

    <!-- Stage Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem;">
      <!-- AERO CARD -->
      <div style="background: rgba(11, 19, 32, 0.8); border: 1px solid rgba(30, 41, 59, 0.9); border-radius: 1.5rem; padding: 2.5rem; display: flex; flex-direction: column; align-items: center; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
        <div style="font-family: var(--font-mono, monospace); font-size: 0.75rem; color: #00FF66; letter-spacing: 2px; font-weight: 700; margin-bottom: 0.5rem;">AI ASSISTANT</div>
        <h2 style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem;">AERO</h2>
        <p style="font-style: italic; color: #94a3b8; font-size: 0.95rem; margin-bottom: 2rem;">"I think, analyze and assist."</p>

        <div style="margin: 1.5rem 0;">
          <AeroMascot client:load size={180} expression="happy" />
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Calm</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Smart</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Helpful</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Curious</span>
        </div>

        <a href="/assets/mascots/aero.svg" download="aero.svg" style="margin-top: 2rem; font-family: var(--font-mono, monospace); font-size: 0.8rem; color: #fff; background: rgba(255,255,255,0.06); padding: 8px 18px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.15); text-decoration: none;">Download Aero SVG ↓</a>
      </div>

      <!-- DASH CARD -->
      <div style="background: rgba(11, 19, 32, 0.8); border: 1px solid rgba(30, 41, 59, 0.9); border-radius: 1.5rem; padding: 2.5rem; display: flex; flex-direction: column; align-items: center; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
        <div style="font-family: var(--font-mono, monospace); font-size: 0.75rem; color: #00FF66; letter-spacing: 2px; font-weight: 700; margin-bottom: 0.5rem;">SYSTEM DRONE</div>
        <h2 style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem;">DASH</h2>
        <p style="font-style: italic; color: #94a3b8; font-size: 0.95rem; margin-bottom: 2rem;">"I move, monitor and execute."</p>

        <div style="margin: 1.5rem 0;">
          <DashMascot client:load size={175} expression="happy" />
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Energetic</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Fast</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Focused</span>
          <span style="font-size: 0.72rem; font-family: var(--font-mono, monospace); background: rgba(0,255,102,0.1); border: 1px solid rgba(0,255,102,0.3); color: #00FF66; padding: 4px 10px; border-radius: 12px;">Reliable</span>
        </div>

        <a href="/assets/mascots/dash.svg" download="dash.svg" style="margin-top: 2rem; font-family: var(--font-mono, monospace); font-size: 0.8rem; color: #fff; background: rgba(255,255,255,0.06); padding: 8px 18px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.15); text-decoration: none;">Download Dash SVG ↓</a>
      </div>
    </div>

    <!-- Complete Duo Vector Asset Card -->
    <div style="background: rgba(11, 19, 32, 0.8); border: 1px solid rgba(0, 255, 102, 0.25); border-radius: 1.5rem; padding: 2.5rem; text-align: center;">
      <h3 style="font-family: var(--font-mono, monospace); font-size: 1rem; color: #00FF66; margin-bottom: 1.5rem; letter-spacing: 2px;">FULL CREW DUO COMPOSITION</h3>
      <div style="max-width: 680px; margin: 0 auto 1.5rem;">
        <img src="/assets/mascots/mascots-crew.svg" alt="Aero and Dash Duo" style="width: 100%; border-radius: 1rem; box-shadow: 0 10px 30px rgba(0,0,0,0.6);" />
      </div>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/assets/mascots/mascots-crew.svg" download="mascots-crew.svg" class="btn btn-primary">Download Duo SVG ↓</a>
        <a href="/mascots.html" class="btn btn-ghost">Open Interactive Studio ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>
