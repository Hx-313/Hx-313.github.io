---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Work — Apps I've Shipped | Hafiz Ali Abdullah" path="/projects">
  <section class="section" style="padding-top:160px">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow">Proof, not promises</span>
        <h2 class="h2">Apps I've shipped to real users</h2>
        <p class="lead">The full case-study grid is next — each project rendered from the content collection. We'll fill these in together, one project at a time.</p>
        <a href="/#book" class="btn btn-primary" style="margin-top:22px">Book a call →</a>
      </div>
    </div>
  </section>
</BaseLayout>
