---
import { contactLinks, siteLinks } from '../core/constants.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div class="footer-brand">
        <a href="/" class="brand"><span>&lt;</span>Hx313<span> /&gt;</span></a>
        <p>Custom Flutter apps &amp; SaaS platforms for founders in the US &amp; UK. Idea to App Store, done right.</p>
      </div>
      <nav class="footer-col" aria-label="Services">
        <h4>Services</h4>
        <a href="/#services">MVP development</a>
        <a href="/#services">Cross-platform apps</a>
        <a href="/#services">SaaS platforms</a>
        <a href="/saas">POS &amp; ordering systems</a>
      </nav>
      <nav class="footer-col" aria-label="Explore">
        <h4>Explore</h4>
        <a href="/projects">Work</a>
        <a href="/#principles">Principles</a>
        <a href="/saas">SaaS</a>
        <a href="/#book">Book a call</a>
      </nav>
      <nav class="footer-col" aria-label="Connect">
